# Copy this file to server/.env for local development. Never commit server/.env.

# Judge0 endpoint. The helper adds base64_encoded=true and wait=true automatically.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions

# Required only when the Judge0 provider uses RapidAPI authentication.
JUDGE0_API_KEY=replace-with-your-secret-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Required in production; use the same real web client ID as the frontend.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id

# Frontend URL allowed to call the API and Socket.IO server.
# Set to your stable HTTPS Vercel origin on Render (no path).
CLIENT_ORIGIN=http://localhost:3000

# The local server port. Deployment providers usually set PORT for you.
PORT=3001

# Local development only. On Render set NODE_ENV=production in the dashboard;
# production startup uses hosting variables and does not load this file.
NODE_ENV=development

# Match durations follow the problem difficulty: easy 15, medium 20, hard 30 minutes.
